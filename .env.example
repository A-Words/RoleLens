# Copy to .env; never commit real values. Development loads .env automatically.
ROLELENS_API_KEY=
ROLELENS_MODEL=
ROLELENS_BASE_URL=https://api.openai.com/v1
# Match the provider endpoint: chat-completions or responses.
ROLELENS_API_PROTOCOL=chat-completions
# Optional absolute data directory. Default: .data
ROLELENS_DATA_DIR=
