# Copy to .env; never commit real values. Development loads .env automatically.
ROLELENS_API_KEY=
ROLELENS_MODEL=
ROLELENS_BASE_URL=https://api.openai.com/v1
# Match the provider endpoint: chat-completions or responses.
ROLELENS_API_PROTOCOL=chat-completions
# Optional development-only Agent tracing. Keep disabled unless explicitly needed.
ROLELENS_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional absolute data directory. Default: .data
ROLELENS_DATA_DIR=
