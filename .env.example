# Optional startup settings. Daily LLM configuration lives in the Settings page.
ROLELENS_MODE=local
# Optional absolute data directory; default .data
ROLELENS_DATA_DIR=

# Development overrides: non-empty values take precedence over saved settings.
# Leave blank to use the Settings page. Remove old overrides and restart to migrate.
ROLELENS_PROVIDER=
ROLELENS_API_KEY=
ROLELENS_MODEL=
ROLELENS_BASE_URL=
# chat-completions or responses
ROLELENS_API_PROTOCOL=
# true or false; blank uses saved setting (default false)
ROLELENS_LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=
